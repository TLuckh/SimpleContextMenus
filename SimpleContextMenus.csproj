<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>0.0.3</Version>
        <AssemblyOriginatorKeyFile>SimpleContextMenuKey.snk</AssemblyOriginatorKeyFile>
        <LangVersion>12</LangVersion>
        <TargetFramework>net481</TargetFramework>
        <!-- Necessary for correct resolution of the app path 
        (e.g. for finding .dll's the app is dependent on if it contains symbols like #  -->
        <SignAssembly>true</SignAssembly>           
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <ContentWithTargetPath Include="CopyToOutputDebug\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>%(RecursiveDir)\%(Filename)%(Extension)</TargetPath>
        </ContentWithTargetPath>
        <ContentWithTargetPath Include="Dependencies\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>%(RecursiveDir)\%(Filename)%(Extension)</TargetPath>
        </ContentWithTargetPath>
    </ItemGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <AdditionalOutputProject>
            ServerManager\ServerManager.csproj;
            Apex.WinForms\Apex.WinForms.csproj;
            ServerRegistrationManager\ServerRegistrationManager.csproj;
        </AdditionalOutputProject>
    </PropertyGroup>


    <!--    ToDo: Apex.WinForms inserted as above & below is a makeshift solution. Problem is that transitive dependencies don't get copied, and 
             AfterTargets that mark all output files either are hallucinated from LLM or don't work because some .csproj are old style.
             Probably just copy all folder contents to the out-dir...-->

    <ItemGroup Condition="'$(Configuration)' == 'Release'">
        <ContentWithTargetPath Include="CopyToOutput\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>%(RecursiveDir)\%(Filename)%(Extension)</TargetPath>
        </ContentWithTargetPath>
    </ItemGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <AdditionalOutputProject>
            ServerRegistrationManager\ServerRegistrationManager.csproj;
            Apex.WinForms\Apex.WinForms.csproj;
        </AdditionalOutputProject>
    </PropertyGroup>
    <Target Name="BuildAndCopyAdditionalOutputProjects_Build"
            AfterTargets="Build"
            Condition="'$(AdditionalOutputProject)' != ''">

        <ItemGroup>
            <_ProjectsToBuild Include="$(AdditionalOutputProject)" />
        </ItemGroup>

        <MSBuild Projects="@(_ProjectsToBuild)"
                 Targets="Build"
                 Properties="Configuration=$(Configuration);Platform=$(Platform)"
                 BuildInParallel="true">
            <Output TaskParameter="TargetOutputs"
                    ItemName="AdditionalOutputProjectBuiltFiles"/>
        </MSBuild>

        <Copy SourceFiles="@(AdditionalOutputProjectBuiltFiles)"
              DestinationFolder="$(OutDir)"
              SkipUnchangedFiles="true"/>
    </Target>


    <Target Name="BuildAndCopyAdditionalOutputProjects_Publish"
            AfterTargets="Publish"
            Condition="'$(AdditionalOutputProject)' != ''">

        <PropertyGroup>
            <FlatPublishDir>$(MSBuildProjectDirectory)\bin\publish\</FlatPublishDir>
        </PropertyGroup>

        <ItemGroup>
            <_ProjectsToBuild Include="$(AdditionalOutputProject)" />
        </ItemGroup>

        <MSBuild Projects="@(_ProjectsToBuild)"
                 Targets="Build"
                 Properties="Configuration=$(Configuration);Platform=$(Platform)"
                 BuildInParallel="true">
            <Output TaskParameter="TargetOutputs"
                    ItemName="AdditionalOutputProjectBuiltFiles"/>
        </MSBuild>

        <Copy SourceFiles="@(AdditionalOutputProjectBuiltFiles)"
              DestinationFolder="$(FlatPublishDir)"
              SkipUnchangedFiles="true"/>
    </Target>
    <ItemGroup>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Remove="SharpShell\**"/>
        <EmbeddedResource Remove="ServerRegistrationManager\**"/>
        <EmbeddedResource Remove="ServerManager\**"/>
        <EmbeddedResource Remove="SimpleContextMenus.Tests\**" />
        <EmbeddedResource Remove="Apex.WinForms\**" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
        <Compile Remove="SharpShell\**"/>
        <Compile Remove="ServerRegistrationManager\**"/>
        <Compile Remove="ServerManager\**"/>
        <Compile Remove="SimpleContextMenus.Tests\**" />
        <Compile Remove="Apex.WinForms\**" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
        <PackageReference Include="MimeTypeMapOfficial" Version="1.0.17"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="SharpShell\**"/>
        <None Remove="ServerRegistrationManager\**"/>
        <None Remove="ServerManager\**"/>
        <None Remove="SimpleContextMenus.Tests\**" />
        <None Remove="Apex.WinForms\**" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="SharpShell\SharpShell.csproj"/>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="StrongNamer" Version="0.2.5" />
    </ItemGroup>
    <Target Name="EnsureClassicMSBuild" BeforeTargets="PrepareForBuild">
        <Message Importance="high" Text="MSBuildRuntimeType=$(MSBuildRuntimeType)"/>
        <Message Importance="high" Text="MSBuildToolsPath=$(MSBuildToolsPath)"/>
        <Message Importance="high" Text="MSBuildBinPath=$(MSBuildBinPath)"/>

        <Error
                Condition="'$(MSBuildRuntimeType)' == 'Core'"
                Text="Falsche Build-Toolchain erkannt: $(MSBuildRuntimeType). Dieses Legacy-.NET-Framework-Projekt enthält vorserialisierte ResX-Ressourcen und muss mit klassischem MSBuild.exe (Visual Studio / Build Tools) gebaut werden, nicht mit dotnet-MSBuild."/>
    </Target>
</Project>
